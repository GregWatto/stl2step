# Python environment (recreate with requirements.txt)
.venv/
__pycache__/
*.pyc
*.pyo

# Editor / OS
.DS_Store
.claude/*
!.claude/skills/
.claude/skills/*/*.local.*

# Generated output (STEP files, reports, colormaps go to /tmp by default)
/out/
*.report/
scratchpad/

